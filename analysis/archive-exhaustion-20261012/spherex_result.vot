<?xml version='1.0' encoding='utf-8'?>
<VOTABLE xmlns="http://www.ivoa.net/xml/VOTable/v1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.4" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.3 http://www.ivoa.net/xml/VOTable/VOTable-1.4.xsd">

<RESOURCE type="meta" utype="ipac:MultiSpectrum-service">
<DESCRIPTION>SPHEREx links service</DESCRIPTION>
<GROUP name="inputParams"> 
<PARAM name="ID" datatype="char" arraysize="*" ref="obs_publisher_did" value="">
<DESCRIPTION>IVOA identifier of SPHEREx spectra image</DESCRIPTION>
</PARAM> 
</GROUP> 
<PARAM name="standardID" datatype="char" arraysize="*" value="ivo://ivoa.net/std/DataLink#links-1.1"/> 
<PARAM name="accessURL" datatype="char" arraysize="*" value="https://irsa.ipac.caltech.edu/datalink/links/spherex"/>
</RESOURCE>

 <RESOURCE type="results" utype="ipac:MultiSpectrum">
  <INFO ID="source_coverage" name="SourceCoverage" value="All user provided sources have SPHEREx coverage." />
  <TABLE utype="ipac:MultiSpectrum">
   <FIELD ID="source_id" datatype="long" name="source_id" ucd="meta.id;meta.main">
    <DESCRIPTION>
     Unique id of the target in this job
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="label" arraysize="10" datatype="char" name="label" ucd="meta.id">
    <DESCRIPTION>
     User-specified label of the target ('Target_NNNN' if no name
     provided)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="ra" datatype="double" name="ra" precision="7" ucd="pos.eq.ra;meta.main" unit="deg" width="11">
    <DESCRIPTION>
     R.A. of the target
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="dec" datatype="double" name="dec" precision="7" ucd="pos.eq.dec;meta.main" unit="deg" width="11">
    <DESCRIPTION>
     DEC of the target
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="n_meas" datatype="int" name="n_meas" ucd="meta.number;obs">
    <DESCRIPTION>
     Number of measurements returned for this source
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="nyquist_comp" datatype="float" name="nyquist_comp" ucd="meta.code.qual">
    <DESCRIPTION>
     Nyquist flag
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="ext_flg" datatype="bit" name="ext_flg" ucd="src.morph">
    <DESCRIPTION>
     True if treated as extended source
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="shape_r" datatype="double" name="shape_r" ucd="src.morph.param;phys.size.axisRadius" unit="arcsec">
    <DESCRIPTION>
     Effective radius
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="sersic" datatype="double" name="sersic" ucd="src.morph.param">
    <DESCRIPTION>
     Sersic parameter for radial profile
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="ab_ratio" datatype="double" name="ab_ratio" ucd="src.morph.param;phys.size.axisRatio">
    <DESCRIPTION>
     Major/minor axis ratio
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="phi" datatype="double" name="phi" ucd="src.morph.param;pos.posAng" unit="deg">
    <DESCRIPTION>
     Position angle
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="lambda" arraysize="*" datatype="float" name="lambda" ucd="em.wl" unit="um" utype="spec:Spectrum.Data.SpectralAxis.Value">
    <DESCRIPTION>
     SPHEREx wavelengths
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="lambda_width" arraysize="*" datatype="float" name="lambda_width" ucd="em.wl;instr.bandwidth" unit="um" utype="spec:Spectrum.Data.SpectralAxis.Accuracy.BinSize">
    <DESCRIPTION>
     SPHEREx wavelength widths
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="flux" arraysize="*" datatype="float" name="flux" ucd="phot.flux;meta.main" unit="uJy" utype="spec:Spectrum.Data.FluxAxis.Value">
    <DESCRIPTION>
     SPHEREx observed flux
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="flux_err" arraysize="*" datatype="float" name="flux_err" ucd="stat.error;phot.flux;meta.main" unit="uJy" utype="spec:Spectrum.Data.FluxAxis.Accuracy.StatError">
    <DESCRIPTION>
     SPHEREx flux error best estimate
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="flux_err_tractor" arraysize="*" datatype="float" name="flux_err_tractor" ucd="stat.error;phot.flux" unit="uJy" utype="spec:Spectrum.Data.FluxAxis.Accuracy.StatError">
    <DESCRIPTION>
     SPHEREx flux error reported by Tractor
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="mjd" arraysize="*" datatype="double" name="mjd" ucd="time.epoch" unit="d">
    <DESCRIPTION>
     Modified Julian Date
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="data_collection" arraysize="4x*" datatype="char" name="data_collection" ucd="meta.version;obs">
    <DESCRIPTION>
     Abbreviated form of the obs_collection containing the data for
     the measurement
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="deep_flg" arraysize="*" datatype="bit" name="deep_flg">
    <DESCRIPTION>
     True if in Deep Field
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="det_id" arraysize="*" datatype="unsignedByte" name="det_id" ucd="meta.id;instr.det">
    <DESCRIPTION>
     Detector ID
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="flags" arraysize="*" datatype="long" name="flags" ucd="meta.code.qual" utype="spec:Spectrum.Data.FluxAxis.Quality">
    <DESCRIPTION>
     Photometry flags
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="fit_ql" arraysize="*" datatype="float" name="fit_ql" ucd="meta.code.qual">
    <DESCRIPTION>
     Photometry metric
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="flux_bkg" arraysize="*" datatype="float" name="flux_bkg" ucd="instr.skyLevel;phot.flux.sb" unit="MJy.sr**-1">
    <DESCRIPTION>
     SPHEREx background surface brightness at source position
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="x_image" arraysize="*" datatype="float" name="x_image" ucd="pos;instr.pixel" unit="pixel">
    <DESCRIPTION>
     x pixel position on LVF image used for fitting
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="y_image" arraysize="*" datatype="float" name="y_image" ucd="pos;instr.pixel" unit="pixel">
    <DESCRIPTION>
     y pixel position on LVF image used for fitting
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="lvf_id" arraysize="*" datatype="long" name="lvf_id" ucd="meta.id;obs">
    <DESCRIPTION>
     ID of LVF exposure used for photometry
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="obs_publisher_did" arraysize="54x*" datatype="char" name="obs_publisher_did" ucd="meta.ref.ivoid">
    <DESCRIPTION>
     Publisher dataset identifier in IRSA archive
    </DESCRIPTION>
   </FIELD>
   <GROUP ID="photometry" utype="ipac:Spectrum.ArrayData">
    <GROUP utype="spec:Spectrum.Data.SpectralAxis">
     <FIELDref ref="lambda" />
     <GROUP utype="spec:Spectrum.Data.SpectralAxis.Accuracy">
      <FIELDref ref="lambda_width" />
     </GROUP>
    </GROUP>
    <GROUP utype="spec:Spectrum.Data.FluxAxis">
     <FIELDref ref="flux" />
     <GROUP utype="spec:Spectrum.Data.FluxAxis.Accuracy">
      <FIELDref ref="flux_err" />
     </GROUP>
     <GROUP utype="spec:Spectrum.Data.FluxAxis.Accuracy">
      <FIELDref ref="flux_err_tractor" />
     </GROUP>
    </GROUP>
    <FIELDref ref="mjd" />
    <FIELDref ref="data_collection" />
    <FIELDref ref="deep_flg" />
    <FIELDref ref="det_id" />
    <FIELDref ref="flags" />
    <FIELDref ref="fit_ql" />
    <FIELDref ref="flux_bkg" />
    <FIELDref ref="x_image" />
    <FIELDref ref="y_image" />
    <FIELDref ref="ra" />
    <FIELDref ref="dec" />
    <FIELDref ref="lvf_id" />
    <FIELDref ref="obs_publisher_did" />
   </GROUP>
