        <DESCRIPTION>instrumental profile-fit photometry flux uncertainty in mag units, band 2</DESCRIPTION>
      </FIELD>
      <FIELD name="w2snr" datatype="double" precision="1" ucd="null" unit="null" width="7">
        <DESCRIPTION>instrumental profile-fit photometry S/N ratio, band 2</DESCRIPTION>
