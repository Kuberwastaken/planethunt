      <FIELD name="dec" datatype="double" precision="7" ucd="pos.eq.dec;meta.main" unit="deg" width="11">
        <DESCRIPTION>declination (J2000)</DESCRIPTION>
      </FIELD>
      <FIELD name="clon" datatype="char" arraysize="*"/>
      <FIELD name="clat" datatype="char" arraysize="*"/>
