        <DESCRIPTION>instrumental profile-fit photometry flux uncertainty in mag units, band 1</DESCRIPTION>
      </FIELD>
      <FIELD name="w1snr" datatype="double" precision="1" ucd="null" unit="null" width="7">
        <DESCRIPTION>instrumental profile-fit photometry S/N ratio, band 1</DESCRIPTION>
      </FIELD>
      <FIELD name="w1rchi2" datatype="double" precision="3" ucd="null" unit="null" width="10">
        <DESCRIPTION>instrumental profile-fit photometry reduced chi^2, band 1</DESCRIPTION>
      </FIELD>
      <FIELD name="w2mpro" datatype="double" precision="3" ucd="phot.mag;em.IR.4-8um" unit="mag" width="7">
