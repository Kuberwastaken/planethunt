<script>
function showAutoTag(_autotagval) {
 var str = '';
 var checkBox = document.getElementById("autotag");
 if (_autotagval != '')  {str = _autotagval}
    if (checkBox.checked == true){
      document.getElementById('tag').value = str;
    }
    else {
      document.getElementById('tag').value = "";
    }
}
</script>

